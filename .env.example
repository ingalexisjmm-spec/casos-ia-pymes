# URL pública, sin barra al final. En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=
# Clave anon o publishable. El servidor la usa para leer fichas publicadas.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave service_role. Solo servidor. Nunca uses el prefijo NEXT_PUBLIC_ aquí.
SUPABASE_SERVICE_ROLE_KEY=

# Resend. El remitente tiene que ser de un dominio verificado.
# onboarding@resend.dev solo entrega al correo de la cuenta de Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Casos IA <hola@tudominio.com>

# Stripe. Prefiere una clave restringida (rk_) con permiso de Checkout Sessions.
# rk_test_ y sk_test_ no hacen cargos reales.
STRIPE_SECRET_KEY=
# Precio único de USD 500. Si lo omites y existe STRIPE_SECRET_KEY,
# el servidor crea la línea de USD 500.
STRIPE_PRICE_ID=
# Alternativa: URL de un Payment Link, si no creas la sesión en el servidor.
STRIPE_PAYMENT_LINK=
# Obligatorio para publicar el patrocinio después del pago.
STRIPE_WEBHOOK_SECRET=
